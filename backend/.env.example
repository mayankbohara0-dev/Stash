# MoneyMate Backend Environment Variables

# Database
DATABASE_URL=postgresql://moneymate:moneymate_secret@localhost:5432/moneymate

# JWT
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Provider (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key-here
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini

# App
APP_NAME=MoneyMate
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Email (for password reset - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@moneymate.app

# Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=100

# Redis (optional - for rate limiting)
REDIS_URL=redis://localhost:6379
